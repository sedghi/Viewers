{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "ohif-jev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ohif-jev.alirz.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../platform/app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
