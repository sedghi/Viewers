{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "alirz",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "alirz.dev/*",
      "zone_name": "alirz.dev"
    }
  ],
  "assets": {
    "directory": "./public"
  }
}
